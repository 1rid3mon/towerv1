rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function maxWave(){return 5000;}
  function isOwner(userId){return request.auth != null && request.auth.uid == userId;}
  function validNum(v,lo,hi){return v is number && v>=lo && v<=hi;}
  function validUserDoc(){
   let d=request.resource.data;
   return d.keys().size()<=20
    && d.get('username','x') is string
    && d.get('username','x').size()<=60
    && d.get('saveData','') is string
    && d.get('saveData','').size()<=200000
    && validNum(d.get('highestWave',1),1,maxWave())
    && d.get('updatedAt',0) is number;
  }
  function validBoardDoc(userId){
   let d=request.resource.data;
   return d.keys().size()<=20
    && d.get('uid',userId)==userId
    && d.get('username','x') is string
    && d.get('username','x').size()>=1
    && d.get('username','x').size()<=20
    && validNum(d.get('highestWave',1),1,maxWave())
    && validNum(d.get('wave',1),1,maxWave())
    && d.get('wave',1)<=d.get('highestWave',1)
    && d.get('damage',0) is number
    && d.get('damage',0)>=0
    && validNum(d.get('prestiges',0),0,100000)
    && d.get('activeSkin','default_cyber') is string
    && d.get('activeSkin','default_cyber').size()<=40
    && d.get('updatedAt',null)==request.time;
  }
  function minSecondsBetweenWrites(){return 20;}
  function maxWaveJumpPerWrite(){return 100;}
  function rateLimitPath(userId){
   return /databases/$(database)/documents/leaderboardRateLimits/$(userId);
  }
  function boardPath(userId){
   return /databases/$(database)/documents/leaderboard/$(userId);
  }
  function rateLimitMatchesBoard(userId){
   let boardAfter = getAfter(boardPath(userId));
   return boardAfter.data.uid == userId
    && boardAfter.data.updatedAt == request.time
    && boardAfter.data.highestWave == request.resource.data.highestWave;
  }
  function withinRateLimit(userId){
   let p = rateLimitPath(userId);
   let nextLimit = getAfter(p);
   return nextLimit.data.uid == userId
    && nextLimit.data.updatedAt == request.time
    && nextLimit.data.highestWave == request.resource.data.highestWave
    && validNum(nextLimit.data.highestWave,1,maxWave())
    && (!exists(p) || (
      request.time > get(p).data.updatedAt + duration.value(minSecondsBetweenWrites(),'s')
      && request.resource.data.highestWave <= get(p).data.highestWave + maxWaveJumpPerWrite()
    ))
    && (resource == null || (
      request.resource.data.highestWave <= resource.data.highestWave + maxWaveJumpPerWrite()
      // Legacy leaderboard documents stored updatedAt as milliseconds (number).
      // Allow one migration write; enforce the cooldown once updatedAt is a Firestore timestamp.
      && (!(resource.data.get('updatedAt', null) is timestamp)
        || request.time > resource.data.updatedAt + duration.value(minSecondsBetweenWrites(),'s'))
    ));
  }
  match /usernameRegistry/{usernameKey} {
   // Registry keys and values are the same normalized ASCII name.
   // This prevents clients from reserving one key while claiming a different username.
   allow read: if request.auth != null;
   allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['uid','username','updatedAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.username is string
    && request.resource.data.username == usernameKey
    && usernameKey.matches('^[a-z0-9_.-]{3,18}$')
    && request.resource.data.updatedAt is number;
   allow update: if request.auth != null
    && resource.data.uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['uid','username','updatedAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.username is string
    && request.resource.data.username == usernameKey
    && usernameKey.matches('^[a-z0-9_.-]{3,18}$')
    && request.resource.data.updatedAt is number;
   allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
  }
  match /friendRequests/{requestId} {
   function validFriendRequest() {
    let d = request.resource.data;
    return d.keys().hasOnly(['fromUid','toUid','fromUsername','toUsername','status','createdAt','updatedAt'])
     && d.fromUid is string && d.toUid is string
     && d.fromUid != d.toUid
     && requestId == d.fromUid + '_' + d.toUid
     && d.fromUsername is string && d.fromUsername.size() >= 3 && d.fromUsername.size() <= 18
     && d.toUsername is string && d.toUsername.size() >= 3 && d.toUsername.size() <= 18
     && d.status == 'pending'
     && d.createdAt == request.time && d.updatedAt == request.time
     && d.toUsername.matches('^[a-z0-9_.-]{3,18}
   }
   allow read: if request.auth != null
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
   allow create: if request.auth != null
    && request.resource.data.fromUid == request.auth.uid
    && validFriendRequest()
    && (!exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid))
      || get(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid)).data.status == 'rejected');
   allow update: if request.auth != null
    && request.resource.data.fromUid == resource.data.fromUid
    && request.resource.data.toUid == resource.data.toUid
    && request.resource.data.fromUsername == resource.data.fromUsername
    && request.resource.data.toUsername == resource.data.toUsername
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly(['fromUid','toUid','fromUsername','toUsername','status','createdAt','updatedAt'])
    && ((resource.data.toUid == request.auth.uid
      && resource.data.status == 'pending'
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.status in ['accepted','rejected'])
     || (resource.data.fromUid == request.auth.uid
      && resource.data.status == 'rejected'
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time));
   allow delete: if request.auth != null
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
  }
  match /users/{userId}{
   allow read: if isOwner(userId);
   allow create,update: if isOwner(userId)&&validUserDoc();
   allow delete: if isOwner(userId);
  }
  match /leaderboard/{userId}{
   allow read: if true;
   allow create,update: if isOwner(userId)&&validBoardDoc(userId)&&withinRateLimit(userId);
   // Keep account deletion working; the separate rate-limit record survives leaderboard-row deletion.
   allow delete: if isOwner(userId);
  }
  match /leaderboardRateLimits/{userId}{
   allow read: if isOwner(userId);
   allow create: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt','highestWave'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && validNum(request.resource.data.highestWave,1,maxWave())
    && rateLimitMatchesBoard(userId)
    && (!exists(boardPath(userId))
      || request.resource.data.highestWave <= get(boardPath(userId)).data.highestWave + maxWaveJumpPerWrite());
   allow update: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt','highestWave'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && validNum(request.resource.data.highestWave,1,maxWave())
    && rateLimitMatchesBoard(userId)
    && request.resource.data.highestWave <= resource.data.highestWave + maxWaveJumpPerWrite()
    // Same one-time migration allowance for an older numeric updatedAt value.
    && (!(resource.data.get('updatedAt', null) is timestamp)
      || request.time > resource.data.updatedAt + duration.value(minSecondsBetweenWrites(),'s'));
   // This record must survive leaderboard deletion or the timer could be reset.
   allow delete: if false;
  }
 }
})
     && d.fromUsername.matches('^[a-z0-9_.-]{3,18}
   }
   allow read: if request.auth != null
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
   allow create: if request.auth != null
    && request.resource.data.fromUid == request.auth.uid
    && validFriendRequest()
    && (!exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid))
      || get(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid)).data.status == 'rejected');
   allow update: if request.auth != null
    && request.resource.data.fromUid == resource.data.fromUid
    && request.resource.data.toUid == resource.data.toUid
    && request.resource.data.fromUsername == resource.data.fromUsername
    && request.resource.data.toUsername == resource.data.toUsername
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly(['fromUid','toUid','fromUsername','toUsername','status','createdAt','updatedAt'])
    && ((resource.data.toUid == request.auth.uid
      && resource.data.status == 'pending'
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.status in ['accepted','rejected'])
     || (resource.data.fromUid == request.auth.uid
      && resource.data.status == 'rejected'
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time));
   allow delete: if request.auth != null
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
  }
  match /users/{userId}{
   allow read: if isOwner(userId);
   allow create,update: if isOwner(userId)&&validUserDoc();
   allow delete: if isOwner(userId);
  }
  match /leaderboard/{userId}{
   allow read: if true;
   allow create,update: if isOwner(userId)&&validBoardDoc(userId)&&withinRateLimit(userId);
   // Keep account deletion working; the separate rate-limit record survives leaderboard-row deletion.
   allow delete: if isOwner(userId);
  }
  match /leaderboardRateLimits/{userId}{
   allow read: if isOwner(userId);
   allow create: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt','highestWave'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && validNum(request.resource.data.highestWave,1,maxWave())
    && rateLimitMatchesBoard(userId)
    && (!exists(boardPath(userId))
      || request.resource.data.highestWave <= get(boardPath(userId)).data.highestWave + maxWaveJumpPerWrite());
   allow update: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt','highestWave'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && validNum(request.resource.data.highestWave,1,maxWave())
    && rateLimitMatchesBoard(userId)
    && request.resource.data.highestWave <= resource.data.highestWave + maxWaveJumpPerWrite()
    // Same one-time migration allowance for an older numeric updatedAt value.
    && (!(resource.data.get('updatedAt', null) is timestamp)
      || request.time > resource.data.updatedAt + duration.value(minSecondsBetweenWrites(),'s'));
   // This record must survive leaderboard deletion or the timer could be reset.
   allow delete: if false;
  }
 }
})
     && exists(/databases/$(database)/documents/usernameRegistry/$(d.toUsername))
     && get(/databases/$(database)/documents/usernameRegistry/$(d.toUsername)).data.uid == d.toUid
     && exists(/databases/$(database)/documents/usernameRegistry/$(d.fromUsername))
     && get(/databases/$(database)/documents/usernameRegistry/$(d.fromUsername)).data.uid == d.fromUid;
   }
   allow read: if request.auth != null
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
   allow create: if request.auth != null
    && request.resource.data.fromUid == request.auth.uid
    && validFriendRequest()
    && (!exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid))
      || get(/databases/$(database)/documents/friendRequests/$(request.resource.data.toUid + '_' + request.resource.data.fromUid)).data.status == 'rejected');
   allow update: if request.auth != null
    && request.resource.data.fromUid == resource.data.fromUid
    && request.resource.data.toUid == resource.data.toUid
    && request.resource.data.fromUsername == resource.data.fromUsername
    && request.resource.data.toUsername == resource.data.toUsername
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly(['fromUid','toUid','fromUsername','toUsername','status','createdAt','updatedAt'])
    && ((resource.data.toUid == request.auth.uid
      && resource.data.status == 'pending'
      && request.resource.data.createdAt == resource.data.createdAt
      && request.resource.data.status in ['accepted','rejected'])
     || (resource.data.fromUid == request.auth.uid
      && resource.data.status == 'rejected'
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time));
   allow delete: if request.auth != null
    && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
  }
  match /users/{userId}{
   allow read: if isOwner(userId);
   allow create,update: if isOwner(userId)&&validUserDoc();
   allow delete: if isOwner(userId);
  }
  match /leaderboard/{userId}{
   allow read: if true;
   allow create,update: if isOwner(userId)&&validBoardDoc(userId)&&withinRateLimit(userId);
   // Keep account deletion working; the separate rate-limit record survives leaderboard-row deletion.
   allow delete: if isOwner(userId);
  }
  match /leaderboardRateLimits/{userId}{
   allow read: if isOwner(userId);
   allow create: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt','highestWave'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && validNum(request.resource.data.highestWave,1,maxWave())
    && rateLimitMatchesBoard(userId)
    && (!exists(boardPath(userId))
      || request.resource.data.highestWave <= get(boardPath(userId)).data.highestWave + maxWaveJumpPerWrite());
   allow update: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt','highestWave'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && validNum(request.resource.data.highestWave,1,maxWave())
    && rateLimitMatchesBoard(userId)
    && request.resource.data.highestWave <= resource.data.highestWave + maxWaveJumpPerWrite()
    // Same one-time migration allowance for an older numeric updatedAt value.
    && (!(resource.data.get('updatedAt', null) is timestamp)
      || request.time > resource.data.updatedAt + duration.value(minSecondsBetweenWrites(),'s'));
   // This record must survive leaderboard deletion or the timer could be reset.
   allow delete: if false;
  }
 }
}