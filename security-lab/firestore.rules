rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function maxWave(){return 5000;}
  function isOwner(userId){return request.auth != null && request.auth.uid == userId;}
  function validNum(v,lo,hi){return v is number && v>=lo && v<=hi;}
  function validUserDoc(){
   let d=request.resource.data;
   return d.keys().size()<=20
    && d.get('username','x') is string
    && d.get('username','x').size()<=60
    && d.get('saveData','') is string
    && d.get('saveData','').size()<=200000
    && validNum(d.get('highestWave',1),1,maxWave())
    && d.get('updatedAt',0) is number;
  }
  function validBoardDoc(userId){
   let d=request.resource.data;
   return d.keys().size()<=20
    && d.get('uid',userId)==userId
    && d.get('username','x') is string
    && d.get('username','x').size()>=1
    && d.get('username','x').size()<=20
    && validNum(d.get('highestWave',1),1,maxWave())
    && validNum(d.get('wave',1),1,maxWave())
    && d.get('wave',1)<=d.get('highestWave',1)
    && d.get('damage',0) is number
    && d.get('damage',0)>=0
    && validNum(d.get('prestiges',0),0,100000)
    && d.get('activeSkin','default_cyber') is string
    && d.get('activeSkin','default_cyber').size()<=40
    && d.get('updatedAt',null)==request.time;
  }
  function minSecondsBetweenWrites(){return 20;}
  function maxWaveJumpPerWrite(){return 15;}
  function rateLimitPath(userId){
   return /databases/$(database)/documents/leaderboardRateLimits/$(userId);
  }
  function withinRateLimit(userId){
   let p = rateLimitPath(userId);
   let nextLimit = getAfter(p);
   return nextLimit.data.uid == userId
    && nextLimit.data.updatedAt == request.time
    && (!exists(p) || request.time > get(p).data.updatedAt + duration.value(minSecondsBetweenWrites(),'s'))
    && (resource == null || (
      request.time > resource.data.updatedAt + duration.value(minSecondsBetweenWrites(),'s')
      && request.resource.data.highestWave <= resource.data.highestWave + maxWaveJumpPerWrite()
    ));
  }
  match /users/{userId}{
   allow read: if isOwner(userId);
   allow create,update: if isOwner(userId)&&validUserDoc();
   allow delete: if isOwner(userId);
  }
  match /leaderboard/{userId}{
   allow read: if true;
   allow create,update: if isOwner(userId)&&validBoardDoc(userId)&&withinRateLimit(userId);
   // Keep account deletion working; the separate rate-limit record survives leaderboard-row deletion.
   allow delete: if isOwner(userId);
  }
  match /leaderboardRateLimits/{userId}{
   allow read: if isOwner(userId);
   allow create: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time;
   allow update: if isOwner(userId)
    && request.resource.data.keys().hasOnly(['uid','updatedAt'])
    && request.resource.data.uid == userId
    && request.resource.data.updatedAt == request.time
    && request.time > resource.data.updatedAt + duration.value(minSecondsBetweenWrites(),'s');
   // This record must survive leaderboard deletion or the timer could be reset.
   allow delete: if false;
  }
 }
}